# Python virtualenvs and bytecode caches.
# No leading slash, so these match at any depth -- but NOT inside the
# WAFT/WAFT submodule, which needs its own rules in WAFT/WAFT/.gitignore.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

.claude
# Generated data -- reproducible from data/raw + data/reference via run_pipeline.py
data/processed/
data/yolo_dataset/
runs/

# Raw captures and reference bank are the actual dataset -- track intentionally,
# not accidentally excluded, but keep large binary blobs (videos) out.
*.mp4
*.avi
